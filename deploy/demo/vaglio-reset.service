[Unit]
Description=Start the Vaglio demonstration again from a clean log with a few days' worth of invented requests, appeals and faxes

[Service]
Type=oneshot
# The accounts, cases and log go; the Let's Encrypt certificate (DATA/tls/acme) is kept, or a new one every night would
# soon meet Let's Encrypt's limit of five a week for one name.
ExecStart=/bin/sh -c 'systemctl stop vaglio-demo && rm -rf /opt/vaglio/acme.keep && { [ ! -d /opt/vaglio/data/tls/acme ] || mv /opt/vaglio/data/tls/acme /opt/vaglio/acme.keep; } && rm -rf /opt/vaglio/data && install -d -o vaglio -g vaglio -m 0700 /opt/vaglio/data /opt/vaglio/data/tls && { [ ! -d /opt/vaglio/acme.keep ] || mv /opt/vaglio/acme.keep /opt/vaglio/data/tls/acme; } && systemctl start vaglio-demo && sleep 4 && runuser -u vaglio -- /opt/vaglio/traffic.py 150 4'
