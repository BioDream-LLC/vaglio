[Unit]
Description=Vaglio public demonstration (invented requests only)
After=network-online.target
Wants=network-online.target

[Service]
User=vaglio
Group=vaglio
WorkingDirectory=/opt/vaglio
ExecStart=/bin/sh -c 'VAGLIO_TOKEN=$(cat /opt/vaglio/conf/token) VAGLIO_APPEALS=$(cat /opt/vaglio/conf/appeals-token) \
  VAGLIO_FAX=$(cat /opt/vaglio/conf/fax-token) exec /opt/vaglio/vaglio serve -addr :8443 \
  -hostname vaglio.perfuse.health -tls-cert /opt/vaglio/tls/fullchain.pem -tls-key /opt/vaglio/tls/privkey.pem \
  -data /opt/vaglio/data -policies /opt/vaglio/policies -token-env VAGLIO_TOKEN -demo-account demo:try-vaglio-demo \
  -appeals-token-env VAGLIO_APPEALS -fax-token-env VAGLIO_FAX -extract pdftotext'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/vaglio/data /opt/vaglio/logs
StandardOutput=append:/opt/vaglio/logs/vaglio.log
StandardError=append:/opt/vaglio/logs/vaglio.log

[Install]
WantedBy=multi-user.target
